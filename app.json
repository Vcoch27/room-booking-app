{
  "expo": {
    "name": "StudySpace",
    "slug": "vku-studyspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "userInterfaceStyle": "light",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#173D35",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vcoch27.studyspace",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./logo.png"
    },
    "android": {
      "package": "com.vcoch27.studyspace",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F0",
        "foregroundImage": "./logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./logo.png"
    },
    "scheme": "studyspace",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#173D35"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F0",
          "dark": {
            "backgroundColor": "#F5F6F0"
          }
        }
      ]
    ]
  }
}
